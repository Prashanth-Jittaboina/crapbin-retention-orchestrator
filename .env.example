# Copy to .env and fill in. Never commit .env.

# LLM Configuration ("gemini" default or "openai" for GPT-4.1 mini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Add ?token=<this> to the webhook URL you paste into Bolna
WEBHOOK_TOKEN=change-me
PORT=8000
FOLLOWUP_INTERVAL_MIN=10

# Keep true until templates are approved and you've checked the messages table
DRY_RUN=true
SEND_WINDOW_START=9
SEND_WINDOW_END=20
REENGAGE_COOLDOWN_DAYS=7
CRAPBIN_CONTACT_PHONE=

# WhatsApp Cloud API (Meta Business Manager -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WA_TEMPLATE_INTERESTED=crapbin_interested_followup
WA_TEMPLATE_REENGAGE=crapbin_reengage
WA_TEMPLATE_LANG=en

# Email (Gmail: use an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
COORDINATOR_EMAIL=
